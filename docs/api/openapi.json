  "components" : {
    "schemas" : {
      "Location" : {
        "type" : "object",
        "properties" : {
          "latitude" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 90,
            "minimum" : -90
          },
          "longitude" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 180,
            "minimum" : -180
          }
        },
        "required" : [ "latitude", "longitude" ]
      },
      "Verification" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "pattern" : "ACTIVE|REJECTED|SUSPENDED"
          },
          "verifiedCategoryIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            },
            "uniqueItems" : true
          },
          "note" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "note", "status", "verifiedCategoryIds" ]
      },
      "Insurance" : {
        "type" : "object",
        "properties" : {
          "pmsbyStatus" : {
            "type" : "string",
            "pattern" : "NOT_ENROLLED|PENDING|ENROLLED"
          },
          "pmjjbyStatus" : {
            "type" : "string",
            "pattern" : "NOT_ENROLLED|PENDING|ENROLLED"
          },
          "evidenceReference" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "evidenceReference", "pmjjbyStatus", "pmsbyStatus" ]
      },
      "Price" : {
        "type" : "object",
        "properties" : {
          "basePrice" : {
            "type" : "number",
            "minimum" : 0.01
          },
          "emergencySupported" : {
            "type" : "boolean"
          },
          "active" : {
            "type" : "boolean"
          }
        },
        "required" : [ "basePrice" ]
      },
      "Config" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "proximityWeight" : {
            "type" : "number",
            "maximum" : 1,
            "minimum" : 0
          },
          "ratingWeight" : {
            "type" : "number",
            "maximum" : 1,
            "minimum" : 0
          },
          "loadWeight" : {
            "type" : "number",
            "maximum" : 1,
            "minimum" : 0
          },
          "welfareRate" : {
            "type" : "number",
            "maximum" : 1,
            "minimum" : 0
          },
          "emergencySurcharge" : {
            "type" : "number",
            "minimum" : 0
          },
          "standardRadiusM" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 50000,
            "minimum" : 100
          },
          "emergencyRadiusM" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 20000,
            "minimum" : 100
          },
          "emergencyTimeoutS" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 90,
            "minimum" : 60
          }
        },
        "required" : [ "emergencySurcharge", "loadWeight", "proximityWeight", "ratingWeight", "welfareRate" ]
      },
      "Onboard" : {
        "type" : "object",
        "properties" : {
          "societyId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "membershipId" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "uan" : {
            "type" : "string",
            "pattern" : "[0-9]{12}"
          },
          "categoryIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            },
            "maxItems" : 10,
            "minItems" : 0,
            "uniqueItems" : true
          },
          "certifications" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "maxLength" : 200,
              "minLength" : 0
            },
            "maxItems" : 20,
            "minItems" : 0
          }
        },
        "required" : [ "categoryIds", "certifications", "membershipId", "societyId", "uan" ]
      },
      "QuoteRequest" : {
        "type" : "object",
        "properties" : {
          "subserviceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "bookingType" : {
            "type" : "string",
            "pattern" : "STANDARD|ON_DEMAND|EMERGENCY"
          }
        },
        "required" : [ "bookingType", "subserviceId" ]
      },
      "CreateJob" : {
        "type" : "object",
        "properties" : {
          "quoteId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "latitude" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 90,
            "minimum" : -90
          },
          "longitude" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 180,
            "minimum" : -180
          },
          "formattedAddress" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "area" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "scheduledTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "area", "formattedAddress", "latitude", "longitude", "quoteId" ]
      },
      "Start" : {
        "type" : "object",
        "properties" : {
          "otp" : {
            "type" : "string",
            "pattern" : "[0-9]{6}"
          }
        },
        "required" : [ "otp" ]
      },
      "Retry" : {
        "type" : "object",
        "properties" : {
          "radiusM" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 20000,
            "minimum" : 100
          },
          "fallbackToOnDemand" : {
            "type" : "boolean"
          }
        }
      },
      "Rating" : {
        "type" : "object",
        "properties" : {
          "stars" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 5,
            "minimum" : 1
          },
          "feedback" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          }
        }
      },
      "Cancel" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "reason" ]
      },
      "Verify" : {
        "type" : "object",
        "properties" : {
          "challengeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "code" : {
            "type" : "string",
            "pattern" : "[0-9]{6}"
          },
          "role" : {
            "type" : "string",
            "pattern" : "CUSTOMER|WORKER"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "challengeId", "code", "name", "role" ]
      },
      "Refresh" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "refreshToken" ]
      },
      "Challenge" : {
        "type" : "object",
        "properties" : {
          "phone" : {
            "type" : "string",
            "pattern" : "\\+[1-9][0-9]{7,14}"
          }
        },
        "required" : [ "phone" ]
      },
      "Manual" : {
        "type" : "object",
        "properties" : {
          "workerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "method" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "note" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "method", "note", "workerId" ]
      },
      "ForecastRequest" : {
        "type" : "object",
        "properties" : {
          "horizonDays" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 30,
            "minimum" : 1
          }
        }
      },
      "Availability" : {
        "type" : "object",
        "properties" : {
          "available" : {
            "type" : "boolean"
          }
        }
      },
      "Profile" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "preferredLang" : {
            "type" : "string",
            "pattern" : "en|hi|ta"
          }
        },
        "required" : [ "name", "preferredLang" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}